DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx
AUTH_SECRET=generate-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
ADMIN_EMAIL=admin@example.com
# Use openai with OPENAI_API_KEY, or custom with the two variables below.
MODERATION_PROVIDER=custom
OPENAI_API_KEY=
# Optional custom text/image moderation provider:
MODERATION_API_URL=
MODERATION_API_KEY=
# Keep true in production: unscanned images wait for staff review.
MODERATION_STRICT=true

# Optional XP reward overrides (server-side only)
XP_PROFILE_COMPLETE=50
XP_SKILLSHOT_PUBLISHED=100
XP_LIKE_RECEIVED=5
XP_SAVE_RECEIVED=10
XP_COMMENT_RECEIVED=10
XP_COMMENT_CREATED=5
XP_DISCUSSION_CREATED=15
XP_DISCUSSION_REPLY=5
XP_HELPFUL_CONTRIBUTION=25
XP_FEATURED_SKILLSHOT=250
XP_SKILLSHOT_OF_WEEK=500
# Optional: lower the GIF frame ceiling (1–120). Total decoded pixels remain capped.
NEXT_PUBLIC_GIF_MAX_FRAMES=120

